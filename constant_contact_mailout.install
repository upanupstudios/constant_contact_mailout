<?php

/**
 * @file
 * Install, update and uninstall functions for Constant Contact Mailout.
 */

/**
 * Remove settings and block keys left behind by earlier module versions.
 *
 * Config schema was added in 1.1.0. Existing sites still carry keys that the
 * module no longer reads, which would fail schema validation on Drupal 11.
 */
function constant_contact_mailout_update_10001(&$sandbox) {
  $messages = [];

  // The sender information moved into each connection, and the debug contact
  // list setting was renamed to "debug_sendto_contact_list". None of these
  // keys are read anymore.
  $obsolete_settings = [
    'sender_from_name',
    'sender_from_email',
    'sender_replyto_email',
    'debug_sendto_contact_list_id',
  ];

  $settings = \Drupal::configFactory()->getEditable('constant_contact_mailout.settings');
  $removed = [];

  foreach ($obsolete_settings as $key) {
    if ($settings->get($key) !== NULL) {
      $settings->clear($key);
      $removed[] = $key;
    }
  }

  if (!empty($removed)) {
    $settings->save();
    $messages[] = t('Removed obsolete settings: @keys.', [
      '@keys' => implode(', ', $removed),
    ]);
  }

  // The subscribe block renamed two message settings. Carry the stored values
  // over so the configured text is not lost, then drop the old keys.
  $renamed_block_settings = [
    'success_message' => 'subscribed_message',
    'unsubscribe' => 'unsubscribed_message',
  ];

  $block_storage = \Drupal::entityTypeManager()->getStorage('block');
  $updated_blocks = 0;

  foreach ($block_storage->loadMultiple() as $block) {
    if ($block->getPluginId() !== 'constant_contact_mailout_subscribe_block') {
      continue;
    }

    $block_settings = $block->get('settings');
    $changed = FALSE;

    foreach ($renamed_block_settings as $old_key => $new_key) {
      if (!array_key_exists($old_key, $block_settings)) {
        continue;
      }

      // Only carry the value over when the new key has nothing in it.
      if (empty($block_settings[$new_key]) && !empty($block_settings[$old_key])) {
        $block_settings[$new_key] = $block_settings[$old_key];
      }

      unset($block_settings[$old_key]);
      $changed = TRUE;
    }

    if ($changed) {
      $block->set('settings', $block_settings);
      $block->save();
      $updated_blocks++;
    }
  }

  if ($updated_blocks > 0) {
    $messages[] = t('Updated @count Constant Contact Subscribe block(s).', [
      '@count' => $updated_blocks,
    ]);
  }

  if (empty($messages)) {
    return t('No obsolete configuration found.');
  }

  return implode(' ', $messages);
}

/**
 * Rebuild routing and menus, and note the new Constant Contact Redirect URI.
 *
 * The administration pages moved out of /admin/config/services. The authorize
 * path is registered as the Redirect URI on the Constant Contact application
 * behind each connection, and that is held in the Constant Contact portal, not
 * in Drupal. Nothing here can update it, so report which connections are
 * affected and let the site builder change them by hand.
 */
function constant_contact_mailout_update_10002(&$sandbox) {
  $path = '/admin/config/constant_contact_mailout/connections/authorize';

  // The old paths are cached in the router and the menu tree, so rebuild both
  // rather than relying on a later cache rebuild. Routes go first, the menu
  // link rebuild resolves each link against the router.
  \Drupal::service('router.builder')->rebuild();
  \Drupal::service('plugin.manager.menu.link')->rebuild();

  $connections = \Drupal::config('constant_contact_mailout.settings')->get('connections');
  $names = [];

  if (!empty($connections)) {
    foreach ($connections as $connection) {
      if (!empty($connection['name'])) {
        $names[] = $connection['name'];
      }
    }
  }

  if (empty($names)) {
    return t('The Constant Contact Mailout administration pages moved to @path. No connections are configured, so there is nothing to update.', [
      '@path' => '/admin/config/constant_contact_mailout',
    ]);
  }

  $arguments = [
    '@path' => $path,
    '@names' => implode(', ', $names),
  ];

  // The update output scrolls past easily and is not shown again, so keep a
  // copy in the log for anyone who hits the authorization failure later. Pass
  // the variables as logger context rather than rendering them into the
  // message, Drupal rewrites "{...}" in a log message as a PSR-3 placeholder.
  \Drupal::logger('constant_contact_mailout')->warning('The Constant Contact Mailout administration pages moved out of /admin/config/services. Update the Redirect URI of the Constant Contact application for these connections to @path on this site: @names.', $arguments);

  return t('The Constant Contact Mailout administration pages moved out of /admin/config/services. Update the Redirect URI of the Constant Contact application for each of these connections to @path on this site: @names. Until then, authorizing or re-authorizing a connection will fail. The exact URL to enter is shown when editing a connection.', $arguments);
}

/**
 * Show the name and email fields on subscribe blocks that have none enabled.
 *
 * Before the "Fields" setting was added, the subscribe form always showed
 * first name, last name, email and confirm email. Blocks saved by those
 * versions have no fields enabled, so the form renders without an email field
 * and nobody can subscribe. The block form requires at least one field, so an
 * empty value only comes from an older block.
 */
function constant_contact_mailout_update_10003(&$sandbox) {
  $fields = ['first_name', 'last_name', 'email', 'confirm_email'];

  $block_storage = \Drupal::entityTypeManager()->getStorage('block');
  $updated_blocks = 0;

  foreach ($block_storage->loadMultiple() as $block) {
    if ($block->getPluginId() !== 'constant_contact_mailout_subscribe_block') {
      continue;
    }

    $block_settings = $block->get('settings');

    if (!empty($block_settings['fields'])) {
      continue;
    }

    $block_settings['fields'] = array_combine($fields, $fields);
    $block->set('settings', $block_settings);
    $block->save();
    $updated_blocks++;
  }

  if ($updated_blocks == 0) {
    return t('All Constant Contact Subscribe blocks already have fields enabled.');
  }

  return t('Enabled the first name, last name, email and confirm email fields on @count Constant Contact Subscribe block(s).', [
    '@count' => $updated_blocks,
  ]);
}
